# Danlite ELM billing portal — environment template
#
# Copy this file to .env.local and fill in values there.
# .env.local is gitignored and MUST NEVER be committed — it holds live secrets.
# This template holds NAMES ONLY. Never put a real value in this file.
#
# All variables below stay EMPTY until:
#   Phase 1 — Supabase  (NEXT_PUBLIC_SUPABASE_*)
#   Phase 4 — Portal    (NEXT_PUBLIC_BILLING_DOMAIN)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
RESEND_API_KEY=
MSG91_AUTH_KEY=

# ── Phase 5 — RAZORPAY IS DELIBERATELY ABSENT FROM THIS FILE ───────────
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET were
# listed here in Phase 4, for a /api/create-order route that no longer
# exists. Order creation moved to the create-order Supabase Edge Function in
# Phase 5, so the portal has no use for any of the three and must not hold
# them: a value that lives in two places has two chances to leak and will
# eventually disagree with itself.
#
# All three now live ONLY as Supabase Edge Function secrets:
#     npx supabase secrets set RAZORPAY_KEY_ID=... RAZORPAY_KEY_SECRET=... \
#                              RAZORPAY_WEBHOOK_SECRET=...
#
# The Key ID does reach the browser — Razorpay's Checkout.js needs it, and it
# authorises nothing without the secret — but it gets there inside the
# create-order response at runtime, never from a file in this repository.
# Do not re-add these names.

# ── Phase 4 ────────────────────────────────────────────────────────────
# Public base URL of this portal, e.g. https://billing.example.com — used to
# build activation links. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_BILLING_DOMAIN=

# NOTE: the portal deliberately does NOT hold a service-role key. Every read it
# performs runs as the signed-in user and is constrained by RLS. RESEND_API_KEY
# and ACTIVATION_WEBHOOK_SECRET live only as Supabase Edge Function secrets and
# must never be added to this file.

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ (API 31+) DARK-MODE boot splash.

      Mirrors values-v31/styles.xml but swaps the splash background to the app's
      darkest brand surface (#0A0D12 — the gauge bezel/face-edge tone) so the
      boot splash dissolves smoothly into the dark UI.

      windowSplashScreenIconBackgroundColor floats the icon on the brand plate
      (@color/ic_launcher_background) — deliberately, and no longer on white.
      The logo art is white and orange now, so a white icon circle would have
      swallowed the DANLITE wordmark entirely. Against #0A0D12 the navy plate
      reads as a barely-there disc, which is the intent: the art carries itself.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF0A0D12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/android12splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

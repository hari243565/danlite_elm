<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ (API 31+) DARK-MODE boot splash.

      Mirrors values-v31/styles.xml but swaps the splash background to the app's
      darkest brand surface (#0A0D12 — the gauge bezel/face-edge tone) so the
      boot splash dissolves smoothly into the dark UI.

      windowSplashScreenIconBackgroundColor floats the icon on
      @color/ic_launcher_background, which is now WHITE rather than the navy
      plate it was when the brand art was white-and-orange. The current art is
      yellow and blue on white, and its wordmark measures rgb(0,66,143): on the
      navy disc it would be a 1.7:1 contrast ratio and would disappear. On its
      own white ground it is 10.9:1, and the white disc reads as a clean brand
      mark against #0A0D12.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#FF0A0D12</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/android12splash</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>

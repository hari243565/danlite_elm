<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 boot window background (API < 31). No logo is drawn here — it
  is the flat colour the window holds while Flutter starts up.

  Matched to the brand plate (@color/ic_launcher_background) rather than white:
  splash_screen.dart paints AppColors.navyGradient, so a white window here
  produced a white flash before a dark screen. This makes the handoff seamless.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) boot-splash icon.

  On Android 12 the OS builds the boot splash from the launcher icon and masks
  it to a 240dp circle inside a 288dp canvas. The launcher foreground is a
  full-bleed wordmark, so its outer edges (top-right of the 'd', bottom of
  'DANLITE') fell outside that circle and were chopped. Insetting the logo
  keeps the entire wordmark inside the safe circle so nothing is cropped.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_foreground"
    android:inset="26%" />
